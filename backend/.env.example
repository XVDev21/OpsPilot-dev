DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
FRONTEND_ORIGIN=http://localhost:3000

# WorkOS AuthKit access-token verification. The JWKS URL is derived from the
# client ID when WORKOS_JWKS_URL is empty.
WORKOS_CLIENT_ID=client_replace_me
WORKOS_API_KEY=sk_test_replace_me
WORKOS_ISSUER=https://api.workos.com/user_management/client_default_application
WORKOS_JWKS_URL=
WORKOS_JWKS_CACHE_SECONDS=300
# Copy this from the WorkOS webhook endpoint after registering
# http://localhost:8000/api/v1/workos/events (or the deployed API equivalent).
WORKOS_WEBHOOK_SECRET=
WORKOS_INVITATION_EXPIRY_DAYS=14

# AI provider credentials stay server-side. Only allowlisted platform providers
# use shared credentials; users can connect vetted alternatives with encrypted keys.
GEMINI_API_KEY=replace-with-server-side-gemini-key
OPENAI_API_KEY=
QWEN_API_KEY=
QWEN_REGION=singapore
QWEN_WORKSPACE_ID=
# Comma-separated high-entropy secrets; the first encrypts and older entries decrypt during rotation.
PROVIDER_CREDENTIAL_ENCRYPTION_KEYS=replace-with-at-least-32-random-characters
AI_PLATFORM_PROVIDERS=gemini
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_INTELLIGENCE=fast
AI_REQUEST_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_PER_MINUTE=5
AI_RATE_LIMIT_PER_DAY=30
WORKFLOW_RETENTION_DAYS=30

# Private case evidence. Local development uses backend/media. Production should use a
# private S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, or equivalent).
CASE_EVIDENCE_UPLOADS_ENABLED=true
CASE_EVIDENCE_MAX_BYTES=8388608
CASE_EVIDENCE_MAX_PIXELS=10000000
CASE_EVIDENCE_MAX_PER_CASE=20
CASE_EVIDENCE_MAX_WORKSPACE_ITEMS=200
CASE_EVIDENCE_MAX_WORKSPACE_BYTES=536870912
CASE_ASSESSMENT_MAX_IMAGES=8
CASE_ASSESSMENT_MAX_IMAGE_BYTES=25165824
CASE_EVIDENCE_S3_BUCKET=
CASE_EVIDENCE_S3_REGION=
CASE_EVIDENCE_S3_ENDPOINT_URL=
CASE_EVIDENCE_S3_ACCESS_KEY=
CASE_EVIDENCE_S3_SECRET_KEY=

# Server-owned model policy. The browser sends only provider and intelligence IDs.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_BALANCED=gemini-3.6-flash
GEMINI_MODEL_HIGH=gemini-2.5-pro
OPENAI_MODEL_FAST=gpt-5.4-nano
OPENAI_MODEL_BALANCED=gpt-5.4-mini
OPENAI_MODEL_HIGH=gpt-5.6-sol
QWEN_MODEL_FAST=qwen3.6-flash-2026-04-16
QWEN_MODEL_BALANCED=qwen3.7-plus-2026-05-26
QWEN_MODEL_HIGH=qwen3.7-max-2026-06-08
AI_MAX_OUTPUT_TOKENS_FAST=1200
AI_MAX_OUTPUT_TOKENS_BALANCED=2200
AI_MAX_OUTPUT_TOKENS_HIGH=3200
