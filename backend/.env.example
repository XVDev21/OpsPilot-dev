DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
FRONTEND_ORIGIN=http://localhost:3000

# WorkOS AuthKit access-token verification. The JWKS URL is derived from the
# client ID when WORKOS_JWKS_URL is empty.
WORKOS_CLIENT_ID=client_replace_me
WORKOS_ISSUER=https://api.workos.com
WORKOS_JWKS_URL=
WORKOS_JWKS_CACHE_SECONDS=300

# AI provider credentials stay server-side. Gemini is the production default;
# OpenAI is optional and appears as unavailable when its key is omitted.
GEMINI_API_KEY=replace-with-server-side-gemini-key
OPENAI_API_KEY=
QWEN_API_KEY=
QWEN_REGION=singapore
QWEN_WORKSPACE_ID=
# Comma-separated high-entropy secrets; the first encrypts and older entries decrypt during rotation.
PROVIDER_CREDENTIAL_ENCRYPTION_KEYS=replace-with-at-least-32-random-characters
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_INTELLIGENCE=fast
AI_REQUEST_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_PER_MINUTE=5
AI_RATE_LIMIT_PER_DAY=30
WORKFLOW_RETENTION_DAYS=30

# Server-owned model policy. The browser sends only provider and intelligence IDs.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_BALANCED=gemini-3.6-flash
GEMINI_MODEL_HIGH=gemini-2.5-pro
OPENAI_MODEL_FAST=gpt-5.4-nano
OPENAI_MODEL_BALANCED=gpt-5.4-mini
OPENAI_MODEL_HIGH=gpt-5.6-sol
QWEN_MODEL_FAST=qwen3.6-flash-2026-04-16
QWEN_MODEL_BALANCED=qwen3.7-plus-2026-05-26
QWEN_MODEL_HIGH=qwen3.7-max-2026-06-08
AI_MAX_OUTPUT_TOKENS_FAST=1200
AI_MAX_OUTPUT_TOKENS_BALANCED=2200
AI_MAX_OUTPUT_TOKENS_HIGH=3200
