DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
FRONTEND_ORIGIN=http://localhost:3000

# WorkOS AuthKit access-token verification. The JWKS URL is derived from the
# client ID when WORKOS_JWKS_URL is empty.
WORKOS_CLIENT_ID=client_replace_me
WORKOS_ISSUER=https://api.workos.com
WORKOS_JWKS_URL=
WORKOS_JWKS_CACHE_SECONDS=300
