# Django service origin. Keep provider credentials server-side in backend/.env.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Replace with the deployed frontend origin when hosting is configured.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WorkOS AuthKit (server-only unless explicitly prefixed NEXT_PUBLIC_).
WORKOS_CLIENT_ID=client_replace_me
WORKOS_API_KEY=sk_test_replace_me
WORKOS_COOKIE_PASSWORD=generate_at_least_32_random_characters
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
